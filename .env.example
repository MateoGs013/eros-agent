# Configuración general
ENV=development
LOG_LEVEL=INFO

# Clave de autenticación para endpoints protegidos y panel de administración
# Debe coincidir exactamente con el valor EROS_API_KEY configurado en el portafolio
EROS_API_KEY=cambiar-por-clave-secreta-larga-y-segura
EROS_ALLOWED_ORIGINS=https://mateogs.tech,https://eros.mateogs.tech,http://localhost:3000

# API del Portafolio de Mateo (en VPS o local)
PORTFOLIO_API_URL=https://api.mateogs.tech/api

# Telegram Bot (C2 privado)
# Obtené tu TOKEN con @BotFather en Telegram
TELEGRAM_BOT_TOKEN=
# Tu ID personal de usuario (para que el bot solo te responda a vos)
# Obtenelo con @userinfobot en Telegram
TELEGRAM_ALLOWED_USER_ID=

# Motores de Inteligencia Artificial
# Gemini API Key (Recomendado para scoring rápido y masivo de ofertas - nivel gratuito)
GEMINI_API_KEY=
# Anthropic API Key (Opcional, para redacción de alta gama de cartas/pitches)
ANTHROPIC_API_KEY=

# Umbral de coincidencia (0-100) para enviar alertas a Telegram
MATCH_MIN_SCORE=75

# Base de datos local
DATABASE_PATH=data/eros.db
