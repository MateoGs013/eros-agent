# Configuración general
ENV=development
LOG_LEVEL=INFO

# Clave de autenticación para endpoints protegidos y panel de administración
# Debe coincidir exactamente con el valor EROS_API_KEY configurado en el portafolio
EROS_API_KEY=cambiar-por-clave-secreta-larga-y-segura
EROS_ALLOWED_ORIGINS=https://mateogs.tech,https://eros.mateogs.tech,http://localhost:3000

# API del Portafolio de Mateo (en VPS o local)
PORTFOLIO_API_URL=https://api.mateogs.tech/api

# Telegram Bot (C2 privado)
# Obtené tu TOKEN con @BotFather en Telegram
TELEGRAM_BOT_TOKEN=
# Tu ID personal de usuario (para que el bot solo te responda a vos)
# Obtenelo con @userinfobot en Telegram
TELEGRAM_ALLOWED_USER_ID=

# Motores de Inteligencia Artificial
# Gemini API Key (Nivel Gratuito de Google AI Studio - 1,500 RPD)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# Anthropic API Key (Opcional, para redacción de alta gama de cartas/pitches)
ANTHROPIC_API_KEY=

# n8n Automation Webhooks
# Contenido (LinkedIn, X, Dev.to). Nunca se usa para postulaciones.
N8N_WEBHOOK_URL=
# Postulaciones por correo (Gmail en n8n). Sin esta URL ni SMTP_HOST no se envían postulaciones.
N8N_APPLICATION_WEBHOOK_URL=
# Secreto compartido: Eros lo manda en el header X-N8N-Secret a ambos webhooks y lo exige
# en /api/webhooks/n8n/callback. Los webhooks de n8n tienen que validarlo (Header Auth).
N8N_WEBHOOK_SECRET=

# SMTP directo (alternativa a n8n para postulaciones)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# URL pública de Eros (enlaces del carousel y del CV en los correos)
PUBLIC_BASE_URL=https://eros.mateogs.tech
# Firma de los enlaces públicos del CV (?token=...). Vacío: se deriva de EROS_API_KEY.
CV_LINK_SECRET=

# Umbral de coincidencia (0-100) para enviar alertas a Telegram
MATCH_MIN_SCORE=75

# Base de datos local
DATABASE_PATH=data/eros.db
