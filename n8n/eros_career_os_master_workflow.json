            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"topic\": $json.topic,\n  \"key_points\": $json.key_points,\n  \"project_name\": $json.project_name\n}",
        "options": {}
      },
