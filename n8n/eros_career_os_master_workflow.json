        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"topic\": {{ JSON.stringify($json.topic) }},\n  \"key_points\": {{ JSON.stringify($json.key_points) }},\n  \"project_name\": {{ JSON.stringify($json.project_name) }}\n}",
        "options": {}
